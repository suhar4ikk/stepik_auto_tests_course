<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Магазин напитков</title>
<style>
  body {
    font-family: Arial, sans-serif;
    background: #111;
    color: #eee;
    margin: 0;
  }
  header {
    background: #000;
    border-bottom: 3px solid #c00;
    padding: 15px;
    text-align: center;
  }
  header h1 {
    margin: 0;
    color: #c00;
  }
  .box {
    max-width: 900px;
    margin: 20px auto;
    padding: 0 15px;
  }
  section {
    margin-bottom: 30px;
  }
  h2 {
    color: #c00;
    border-bottom: 1px solid #333;
    padding-bottom: 5px;
  }
  .products {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }
  .card {
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 10px;
    width: 200px;
  }
  .card .icon {
    font-size: 40px;
    text-align: center;
  }
  .card h3 {
    margin: 8px 0;
    font-size: 15px;
  }
  .card p {
    color: #999;
    font-size: 13px;
    margin: 5px 0;
  }
  .card .price {
    color: #c00;
    font-weight: bold;
    font-size: 16px;
  }
  .card button {
    background: #c00;
    color: white;
    border: none;
    padding: 8px;
    width: 100%;
    margin-top: 8px;
    cursor: pointer;
    border-radius: 4px;
  }
  .card button:hover {
    background: #e00;
  }
  .age {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }
  .age div {
    background: #1a1a1a;
    border: 2px solid #c00;
    padding: 30px;
    border-radius: 10px;
    text-align: center;
    max-width: 350px;
  }
  .age button {
    background: #c00;
    color: white;
    border: none;
    padding: 10px 30px;
    margin-top: 15px;
    cursor: pointer;
    border-radius: 4px;
    font-size: 15px;
  }
  .age button:hover {
    background: #e00;
  }
  #cart {
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 15px;
  }
  .cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid #333;
  }
  .cart-item button {
    background: #c00;
    color: white;
    border: none;
    padding: 4px 10px;
    cursor: pointer;
    border-radius: 3px;
    margin-left: 5px;
  }
  #cartTotal {
    margin-top: 15px;
    font-size: 18px;
    font-weight: bold;
  }
  #cartTotal span {
    color: #c00;
  }
  footer {
    background: #000;
    border-top: 3px solid #c00;
    padding: 15px;
    text-align: center;
    color: #888;
    margin-top: 30px;
  }
</style>
</head>
<body>
<div class="age" id="ageBox">
  <div>
    <h2>Вам есть 18 лет?</h2>
    <p>На сайте есть алкоголь и энергетики</p>
    <label>
      <input type="checkbox" id="ageCheck"> Мне есть 18 лет
    </label>
    <br>
    <button onclick="checkAge()">Войти</button>
    <p id="ageError" style="color:#c00"></p>
  </div>
</div>

<header>
  <h1>DRINK_HUB</h1>
</header>

<div class="box">

  <section id="home">
    <h2>Главная</h2>
    <p>Магазин напитков с доставкой. Пиво, вино, виски, энергетики, соки, вода, кофе и чай.</p>
    <p>Доставка по городу за 1 час. Бесплатно от 2000 рублей.</p>
  </section>

  <section id="catalog">
    <h2>Каталог</h2>
    <div class="products" id="products"></div>
  </section>

  <section id="cart">
    <h2>Корзина</h2>
    <div id="cartList">Корзина пуста</div>
    <div id="cartTotal"></div>
    <button onclick="checkout()" style="background:#c00;color:white;border:none;padding:10px 20px;margin-top:10px;cursor:pointer;border-radius:4px;">Оформить заказ</button>
  </section>

  <section id="about">
    <h2>О нас</h2>
    <p>Магазин работает с 2026 года. Продаём напитки только для лиц старше 18 лет. При доставке алкоголя курьер проверяет паспорт.</p>
    <p>Телефон: 67<br>
    Email: brosai_buhat@gold.com<br>
    Адрес: не скажем, найдешь сам</p>
  </section>

</div>

<footer>
  2026 DRINK_HUB. 18+
</footer>

<script>
var products = [
  { id: 1, name: "Виски Glen Force", cat: "Алкоголь", price: 2490, icon: "🥃", age: true },
  { id: 2, name: "Пиво Craft Ale", cat: "Алкоголь", price: 290, icon: "🍺", age: true },
  { id: 3, name: "Вино Bordeaux", cat: "Алкоголь", price: 1690, icon: "🍷", age: true },
  { id: 4, name: "Energy Boost X", cat: "Энергетик", price: 149, icon: "⚡", age: true },
  { id: 5, name: "Red Bull", cat: "Энергетик", price: 129, icon: "🥤", age: true },
  { id: 6, name: "Сок апельсиновый", cat: "Сок", price: 189, icon: "🍊", age: false },
  { id: 7, name: "Сок яблочный", cat: "Сок", price: 159, icon: "🍏", age: false },
  { id: 8, name: "Вода San Pellegrino", cat: "Вода", price: 249, icon: "💧", age: false },
  { id: 9, name: "Вода Aqua Pure", cat: "Вода", price: 79, icon: "🚰", age: false },
  { id: 10, name: "Чай Green Leaf", cat: "Чай", price: 219, icon: "🍵", age: false },
  { id: 11, name: "Кофе Arabica", cat: "Кофе", price: 449, icon: "☕", age: false }
];

var cart = {};
function checkAge() {
  if (document.getElementById("ageCheck").checked) {
    document.getElementById("ageBox").style.display = "none";
  } else {
    document.getElementById("ageError").innerHTML = "Поставьте галочку";
  }
}


function showProducts() {
  var html = "";
  for (var i = 0; i < products.length; i++) {
    var p = products[i];
    html += '<div class="card">';
    html += '<div class="icon">' + p.icon + '</div>';
    html += '<h3>' + p.name + (p.age ? ' <span style="color:#c00">18+</span>' : '') + '</h3>';
    html += '<p>' + p.cat + '</p>';
    html += '<div class="price">' + p.price + ' ₽</div>';
    html += '<button onclick="addToCart(' + p.id + ')">В корзину</button>';
    html += '</div>';
  }
  document.getElementById("products").innerHTML = html;
}

function addToCart(id) {
  if (cart[id]) {
    cart[id]++;
  } else {
    cart[id] = 1;
  }
  showCart();
  alert("Товар добавлен в корзину");
}

function changeQty(id, delta) {
  cart[id] = cart[id] + delta;
  if (cart[id] <= 0) {
    delete cart[id];
  }
  showCart();
}

function showCart() {
  var ids = Object.keys(cart);
  if (ids.length === 0) {
    document.getElementById("cartList").innerHTML = "Корзина пуста";
    document.getElementById("cartTotal").innerHTML = "";
    return;
  }
  var html = "";
  var total = 0;
  for (var i = 0; i < ids.length; i++) {
    var id = ids[i];
    var p = getProduct(id);
    var qty = cart[id];
    total += p.price * qty;
    html += '<div class="cart-item">';
    html += '<div>' + p.icon + ' ' + p.name + ' — ' + p.price + ' ₽ × ' + qty + '</div>';
    html += '<div>';
    html += '<button onclick="changeQty(' + id + ', -1)">-</button>';
    html += '<button onclick="changeQty(' + id + ', 1)">+</button>';
    html += '<button onclick="changeQty(' + id + ', -' + qty + ')">Удалить</button>';
    html += '</div>';
    html += '</div>';
  }
  document.getElementById("cartList").innerHTML = html;
  document.getElementById("cartTotal").innerHTML = "Итого: <span>" + total + " ₽</span>";
}
function getProduct(id) {
  for (var i = 0; i < products.length; i++) {
    if (products[i].id == id) return products[i];
  }
}

function checkout() {
  if (Object.keys(cart).length === 0) {
    alert("Корзина пуста");
    return;
  }
  alert("Заказ оформлен! Мы вам позвоним.");
  cart = {};
  showCart();
}
showProducts();
showCart();
</script>
</body>
</html>
